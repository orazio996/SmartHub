<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="15.0" style="-fx-background-color: #f9f9f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="domotica.ui.fx.DispositivoController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Label fx:id="lblNomeTarget" text="Dispositivo: --" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
         <Region HBox.hgrow="ALWAYS" />
         <Button text="Genera Report" onAction="#apriFinestraReport" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
         <Button text="Lancia Sequenza" onAction="#apriFinestraSequenza" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
      </HBox>
      
      <VBox style="-fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;" prefHeight="5.0" />
      
      <Label fx:id="lblTipoTarget" text="Marca: -- | Modello: --" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
      
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="contenitoreParametri" spacing="10.0">
               <padding>
                  <Insets top="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>