<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="domotica.ui.fx.HomeGUIController">
   
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Sistema">
            <items>
              <MenuItem mnemonicParsing="false" text="Impostazioni" />
              <MenuItem mnemonicParsing="false" text="Esci" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Funzioni Domotiche">
            <items>
              <MenuItem mnemonicParsing="false" text="Aggiungi Dispositivo/Gruppo" />
              <MenuItem mnemonicParsing="false" text="Gestisci Routine" />
              <MenuItem mnemonicParsing="false" text="Vedi Metriche" />
              <MenuItem mnemonicParsing="false" text="Esegui Sequenza" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>

   <left>
      <ListView fx:id="dispositivi" prefHeight="575.0" prefWidth="250.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </ListView>
   </left>

   <center>
      <VBox fx:id="pannelloDettagli" alignment="TOP_LEFT" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;" BorderPane.alignment="CENTER">
         <children>
            <Label text="PANNELLO DI CONTROLLO" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            
            <VBox style="-fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;" prefHeight="5.0" />
            
            <Label fx:id="lblNomeTarget" text="Dispositivo: --" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            
            <Label fx:id="lblTipoTarget" text="Tipo: --" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
            
            <VBox fx:id="contenitoreParametri" spacing="10.0">
               <padding>
                  <Insets top="20.0" />
               </padding>
            </VBox>
            
         </children>
         
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   
</BorderPane>